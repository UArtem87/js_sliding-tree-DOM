"use strict";
var items = document.querySelectorAll("li");
items.forEach(function(el) {
    var child = el.querySelector("ul");
    if (child) {
        var arrOfChilds = Array.from(el.childNodes);
        var textNode = arrOfChilds.find(function(node) {
            return node.nodeType === Node.TEXT_NODE;
        });
        if (textNode) {
            textNode.data = textNode.data.trim();
            var wrap = document.createElement("span");
            wrap.classList.add("tree__header");
            wrap.append(textNode);
            el.prepend(wrap);
        }
    }
});
document.querySelector(".tree").addEventListener("click", function(e) {
    var header = e.target.closest(".tree__header");
    if (header) {
        var childs = header.nextElementSibling;
        if (childs) {
            var computedStyle = window.getComputedStyle(childs);
            if (computedStyle.display !== "none") childs.style.display = "none";
            else childs.style.display = "block";
        }
    }
});

